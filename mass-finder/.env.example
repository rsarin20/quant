# ---------------------------------------------------------------------------
# Mass Finder — environment
#
# The app runs with NO configuration at all. Without an API key it still finds
# churches worldwide via OpenStreetMap and still reads Mass times off parish
# websites using deterministic text matching — it just labels those times as
# unconfirmed, which they are.
# ---------------------------------------------------------------------------

# --- Reading parish websites with Claude (optional but recommended) --------
# Without this, Mass times come only from OpenStreetMap tags and simple text
# matching. With it, Claude reads the pages properly — tables, prose, bulletin
# PDFs — and every time it reports is verified back against the source text
# before being shown, so it cannot invent a Mass that isn't on the page.
ANTHROPIC_API_KEY=

# Model used for extraction. Defaults to claude-opus-5.
# MASSFINDER_MODEL=claude-opus-5

# Effort level for extraction: low | medium | high | xhigh | max.
# Defaults to medium, which handles ordinary parish pages well. Raise it if you
# see schedules being missed on awkwardly-laid-out sites.
# MASSFINDER_EFFORT=medium

# --- Church discovery ------------------------------------------------------
# Overpass mirrors, tried in order. The defaults are the public volunteer-run
# instances; point this at your own instance for production traffic, which is
# both faster and the polite thing to do at scale.
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Place-name lookup. Nominatim's public instance caps automated use at roughly
# one request a second; run your own or use a commercial geocoder for real load.
# NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org

# --- Storage ---------------------------------------------------------------
# Where cached churches, schedules and user reports are written.
# MASSFINDER_DATA_DIR=./data

# --- Demonstration mode ----------------------------------------------------
# Serves four invented example parishes instead of querying OpenStreetMap, so
# the interface can be seen working with no network access. Everything is
# labelled as fake in the UI. Never enable this in production.
# MASSFINDER_DEMO=1
